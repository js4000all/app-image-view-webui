        "required": [
          "job_id"
        ],
        "title": "TagIndexRefreshJobStartResponse",
        "type": "object"
      },
      "TagIndexRefreshJobStatusResponse": {
        "properties": {
          "counters": {
            "$ref": "#/components/schemas/TagIndexRefreshJobCounters"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
