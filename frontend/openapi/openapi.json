          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "processed_files": {
            "title": "Processed Files",
            "type": "integer"
          },
          "progress_phase": {
            "enum": [
              "queued",
              "listing",
              "scanning",
              "applying",
              "finalizing",
              "done",
              "failed"
            ],
            "title": "Progress Phase",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "total_files": {
            "title": "Total Files",
            "type": "integer"
          }
