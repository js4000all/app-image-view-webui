          "indexed_tags": {
            "title": "Indexed Tags",
            "type": "integer"
          }
        },
        "required": [
          "indexed_files",
          "indexed_tags"
        ],
        "title": "TagIndexRefreshResponse",
        "type": "object"
      },
      "TagQueryRequest": {
        "properties": {
          "mode": {
            "default": "or",
            "enum": [
              "and",
              "or"
            ],
            "title": "Mode",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "tags"
        ],
        "title": "TagQueryRequest",
        "type": "object"
      },
      "TagQueryResponse": {
        "properties": {
          "file_ids": {
            "items": {
              "type": "string"
            },
            "title": "File Ids",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "file_ids",
          "total"
        ],
        "title": "TagQueryResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
